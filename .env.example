# Copiar este archivo como .env y cambiar los valores. El .env no se commitea.

# Base de datos del catálogo
DB_NAME=catalogo
DB_USER=catalogo
DB_PASSWORD=cambiar-esta-clave

# Puertos publicados en la máquina
CATALOGO_PORT=8081
CATALOGO_DB_PORT=5433

# API de la cátedra: URL base y JWT técnico de la cuenta del proyecto (ADR-0005). Redis y Kafka
# se piden a la cátedra al arrancar.
CATEDRA_API_URL=http://servidor-de-la-catedra:puerto
CATEDRA_TECHNICAL_TOKEN=jwt-tecnico
